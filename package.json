{
  "name": "clm-stats.app",
  "version": "1.0.0",
  "repository": "git@github.com:clm-stats/clm-stats.app.git",
  "author": "Mitch Dzugan <mitchdzugan@gmail.com>",
  "license": "MIT",
  "scripts": {
    "build:purescript": "spago build",
    "build:js": "vite build -c ./vite.client.mjs",
    "build:css": "postcss -o ./dist/styles.css ./styles.css",
    "dev:mkhtml": "node -e 'require(\"fs\").writeFileSync(__dirname+\"/index.html\",require(\"./js/htmlDocTemplate.js\").default({timeline:JSON.parse(require(\"fs\").readFileSync(require(\"path\").join(process.env.CLM_STATS_PAGES_CO,\"docs\",\"timeline.json\"),\"utf8\"))}))'",
    "dev:start": "vite dev",
    "dev": "run-s dev:mkhtml dev:start",
    "dev:gh-db": "cross-env CLM_STATS_APP_FORCE_PROXY=yes run-s dev"
  },
  "alias": {
    "react": "preact/compat",
    "react-dom/test-utils": "preact/test-utils",
    "react-dom": "preact/compat",
    "react/jsx-runtime": "preact/jsx-runtime"
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "fuzzysort": "^3.1.0",
    "preact": "^10.28.4"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.3",
    "@tailwindcss/postcss": "^4.2.1",
    "cross-env": "^10.1.0",
    "cssnano": "^9.8.0",
    "daisyui": "^5.5.19",
    "http-proxy-middleware": "^3.0.5",
    "ini": "^7.0.0",
    "mkdirp": "^3.0.1",
    "npm-run-all": "^4.1.5",
    "parcel": "^2.16.4",
    "postcss": "^8.5.30",
    "postcss-cli": "^12.0.0",
    "preact-render-to-string": "^6.8.1",
    "purescript": "^0.15.16",
    "rimraf": "^6.1.3",
    "rollup-plugin-visualizer": "^7.1.1",
    "static-server": "^2.2.1",
    "tailwindcss": "^4.2.1",
    "tailwindcss-animated": "^2.0.0",
    "terser": "^5.51.2",
    "vite": "^7.3.1"
  },
  "@parcel/resolver-default": {
    "packageExports": true
  }
}
